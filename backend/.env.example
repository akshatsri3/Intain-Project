# ─────────────────────────────────────────────────────────────────
# Loan Data Verification Copilot — Backend Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local example:  postgresql://postgres:yourpassword@localhost:5432/loan_copilot
# Vercel/Neon:    postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loan_copilot

# JWT secret — use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-production

# JWT algorithm (do not change)
ALGORITHM=HS256

# How long tokens stay valid (minutes). 480 = 8 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Your deployed frontend URL — used for CORS whitelisting
# Example: https://loan-copilot.vercel.app
FRONTEND_URL=http://localhost:5173
